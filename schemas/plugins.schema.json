{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/niuwoai/musemate-plugins/schemas/plugins.schema.json",
  "title": "MuseMate plugins index",
  "type": "object",
  "required": ["schemaVersion", "packs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "index": {
      "type": "object",
      "additionalProperties": true
    },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "required": ["id", "name", "description", "author", "kind", "runtimes", "categories", "minAppVersion", "addedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "repo": { "type": ["string", "null"], "pattern": "^[^\\s/]+/[^\\s/]+$" },
        "npm": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["plugin", "theme", "template", "builtin", "obsidian-compat"]
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["preview", "transform", "process", "obsidian-shim"]
          },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "obsidianCompat": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "tier": { "type": "string", "enum": ["A", "B"] },
            "upstreamId": { "type": "string" },
            "requiredApis": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["tier"]
        },
        "minAppVersion": { "type": "string", "minLength": 1 },
        "addedAt": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["active", "placeholder", "example", "planned", "deprecated"]
        }
      },
      "anyOf": [
        { "properties": { "repo": { "type": "string" } }, "required": ["repo"] },
        { "properties": { "npm": { "type": "string" } }, "required": ["npm"] }
      ]
    }
  }
}
